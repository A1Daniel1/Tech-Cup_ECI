# Optional. Base URL of the backend API as seen by the browser (including the /api prefix).
# Leave empty to use the relative "/api" prefix, which Vite proxies to the backend in dev.
# Example for a deployed backend: VITE_API_URL=https://techcup.example.edu/api
VITE_API_URL=

# Optional. Where the Vite dev server proxies "/api" requests to (dev only).
VITE_API_PROXY_TARGET=http://localhost:8080
